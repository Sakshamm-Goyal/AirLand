{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/drizzle",
      "!**/.expo",
      "!**/ios",
      "!**/android",
      "!docs/mockup",
      "!apps/mobile/scripts",
      "!**/dist",
      "!**/test-results",
      "!**/.pnpm-store",
      "!**/playwright-report",
      "!**/*.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/src/app/(app)/(tabs)/_layout.tsx", "apps/mobile/src/app/(app)/(tabs)/_layout.web.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off"
          }
        }
      }
    }
  ]
}
