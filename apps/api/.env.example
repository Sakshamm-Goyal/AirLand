# Copy to .env. Defaults in src/config.ts work with `pnpm db:up` (docker compose).
DATABASE_URL=postgres://lc:lc@localhost:5433/landconnect
JWT_SECRET=generate-with-openssl-rand-base64-48
PUBLIC_URL=http://192.168.1.10:4000   # your LAN IP so a phone can reach it
LIVEKIT_URL=ws://192.168.1.10:7880    # or wss://<project>.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
